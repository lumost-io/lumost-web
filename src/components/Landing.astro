---
import { Image } from 'astro:assets';
import type { Dict } from '../i18n/id';
import { site, waLink } from '../site';
import ContactForm from './ContactForm.astro';
import overview from '../assets/shots/01-overview.png';
import traces from '../assets/shots/02-traces.png';
import services from '../assets/shots/03-services.png';
import dashboard from '../assets/shots/06-dashboard.png';
import alerts from '../assets/shots/07-alerts.png';
import hostDetail from '../assets/shots/13-host-detail.png';
import setup from '../assets/shots/15-onboarding-setup.png';

interface Props { t: Dict }
const { t } = Astro.props;
const tourImages = [overview, traces, services, dashboard, alerts, hostDetail];
const wa = waLink(t.contact.waText);
const waPath = 'M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.46 1.32 4.97L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.01c5.46 0 9.9-4.45 9.9-9.91C21.95 6.45 17.5 2 12.04 2m0 18.15h-.01a8.2 8.2 0 0 1-4.18-1.15l-.3-.18-3.11.82.83-3.04-.2-.31a8.19 8.19 0 0 1-1.26-4.38c0-4.54 3.7-8.23 8.24-8.23 2.2 0 4.27.86 5.82 2.41a8.18 8.18 0 0 1 2.41 5.83c0 4.54-3.7 8.23-8.24 8.23m4.52-6.16c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.13-.16.24-.64.8-.79.97-.14.16-.29.18-.54.06-.25-.12-1.05-.39-1.99-1.23-.74-.66-1.24-1.47-1.38-1.72-.15-.25-.02-.38.11-.5.11-.11.25-.29.37-.43.13-.15.17-.25.25-.41.08-.17.04-.31-.02-.43-.06-.12-.56-1.34-.76-1.84-.2-.48-.4-.42-.56-.43h-.47c-.16 0-.42.06-.64.31-.22.25-.84.82-.84 2 0 1.18.86 2.32.98 2.48.12.17 1.69 2.58 4.1 3.62.57.25 1.02.4 1.37.51.58.18 1.1.16 1.52.1.46-.07 1.42-.58 1.62-1.14.2-.56.2-1.04.14-1.14-.06-.11-.22-.17-.47-.29';
---
<a class="skip" href="#main">{t.nav.skip}</a>

<header class="site-header">
  <div class="wrap">
    <a class="brand" href="#top" aria-label="Lumost"><img src="/logo-mark.svg" alt="" width="32" height="32" />Lumost</a>
    <nav class="nav" aria-label="Main">
      <a href="#produk">{t.nav.product}</a>
      <a href="#cara-kerja">{t.nav.how}</a>
      <a href="#data">{t.nav.data}</a>
      <a class="btn primary" href="#kontak">{t.nav.cta}</a>
    </nav>
  </div>
</header>

<main id="main">
  <section class="hero" id="top">
    <img class="mark-bg" src="/logo-mark.svg" alt="" aria-hidden="true" />
    <div class="wrap grid">
      <div class="copy">
        <p class="eyebrow">{t.hero.eyebrow}</p>
        <h1>{t.hero.title.map((l, i) => <><span>{l}</span>{i < t.hero.title.length - 1 ? ' ' : ''}</>)}</h1>
        <p class="sub">{t.hero.sub}</p>
        <div class="cta"><a class="btn primary" href="#kontak">{t.hero.primary}</a><a class="btn ghost" href="#produk">{t.hero.secondary}</a></div>
        <p class="note">{t.hero.note}</p>
      </div>
      <div class="shot">
        <Image src={overview} alt={t.hero.shotAlt} width={1280} loading="eager" fetchpriority="high" />
      </div>
    </div>
  </section>

  <section class="signals" aria-label="Signals">
    <div class="wrap">
      <ul>
        {t.signals.map((s) => <li><span class="n">{s.n}</span><h3>{s.t}</h3><p>{s.d}</p></li>)}
      </ul>
    </div>
  </section>

  <section class="band" id="produk">
    <div class="wrap">
      <p class="kicker">{t.tour.kicker}</p>
      <h2 class="title">{t.tour.title}</h2>
      <p class="lede">{t.tour.lede}</p>
      <div class="tour">
        {t.tour.items.map((it, i) => (
          <input class="tour-radio" type="radio" name="tour" id={`tab-${i}`} checked={i === 0} aria-label={it.tab} />
        ))}
        <div class="tour-tabs">
          {t.tour.items.map((it, i) => <label for={`tab-${i}`}>{it.tab}</label>)}
        </div>
        {t.tour.items.map((it, i) => (
          <div class={`panel panel-${i}`}>
            <div><h3>{it.title}</h3><p>{it.text}</p></div>
            <figure><Image src={tourImages[i]} alt={it.alt} width={1280} loading={i === 0 ? 'eager' : 'lazy'} /></figure>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="band wash" id="cara-kerja">
    <div class="wrap">
      <p class="kicker">{t.how.kicker}</p>
      <h2 class="title">{t.how.title}</h2>
      <p class="lede">{t.how.lede}</p>
      <div class="how-grid">
        <ol class="steps">
          {t.how.steps.map((st) => <li><h3>{st.t}</h3><p>{st.d}</p></li>)}
        </ol>
        <div class="how-side">
          <p class="code-title">{t.how.codeTitle}</p>
<pre class="code"><code><span class="c"># environment variables</span>
OTEL_EXPORTER_OTLP_ENDPOINT=<span class="s">"&lt;endpoint&gt;"</span>
OTEL_EXPORTER_OTLP_HEADERS=<span class="s">"Authorization=Bearer &lt;ingest-key&gt;"</span>
OTEL_SERVICE_NAME=<span class="s">"my-service"</span></code></pre>
          <p class="code-note">{t.how.codeNote}</p>
          <p class="agent">{t.how.agentNote}</p>
          <figure class="how-shot"><Image src={setup} alt={t.how.shotAlt} width={1200} loading="lazy" /></figure>
        </div>
      </div>
    </div>
  </section>

  <section class="band dark" id="data">
    <div class="wrap">
      <p class="kicker">{t.data.kicker}</p>
      <h2 class="title">{t.data.title}</h2>
      <p class="lede">{t.data.lede}</p>
      <div class="cards">
        {t.data.items.map((d) => <div class="card"><h3>{d.t}</h3><p>{d.d}</p></div>)}
      </div>
      <p class="compliance"><strong>{t.data.compliance.title}</strong> {t.data.compliance.text}</p>
    </div>
  </section>

  <section class="band wash" id="partner">
    <div class="wrap partner">
      <div>
        <p class="kicker">{t.partner.kicker}</p>
        <h2 class="title">{t.partner.title}</h2>
        <p class="lede">{t.partner.lede}</p>
        <a class="btn solid" href="#kontak">{t.partner.cta}</a>
      </div>
      <ul class="ticks">{t.partner.points.map((p) => <li>{p}</li>)}</ul>
    </div>
  </section>

  <section class="band dark" id="kontak">
    <div class="wrap">
      <p class="kicker">{t.contact.kicker}</p>
      <h2 class="title">{t.contact.title}</h2>
      <div class="contact-grid">
        <div>
          <p class="lede" style="margin-top:0">{t.contact.lede}</p>
          <div class="person">
            <p class="name">{site.founder.name}</p>
            <p class="role">{t.contact.personRole}</p>
            <p class="line"><a href={`mailto:${site.founder.email}`}>{site.founder.email}</a></p>
            <p class="line"><a href={wa}>{site.whatsapp.display}</a></p>
            <p class="reply">{t.contact.reply}</p>
            <a class="btn wa-btn" href={wa}>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d={waPath} /></svg>{t.contact.waLabel}
            </a>
          </div>
        </div>
        <ContactForm t={t} />
      </div>
    </div>
  </section>
</main>

<footer class="site-footer">
  <div class="wrap">
    <a class="brand" href="#top"><img src="/logo-mark.svg" alt="" width="24" height="24" />Lumost</a>
    <span class="tag">{t.footer.tag}</span>
    <span>lumost.id · {t.footer.rights}</span>
  </div>
</footer>
