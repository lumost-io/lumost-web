---
import '../styles/global.css';
import type { Dict } from '../i18n/id';
import { site } from '../site';

interface Props { t: Dict; path: string }
const { t, path } = Astro.props;
const canonical = new URL(path, site.url).href;
const ld = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.name,
  url: site.url,
  logo: `${site.url}/logo-mark.svg`,
  founder: { '@type': 'Person', name: site.founder.name },
  email: site.founder.email,
};
---
<!doctype html>
<html lang={t.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.meta.title}</title>
    <meta name="description" content={t.meta.description} />
    <meta name="theme-color" content="#100f0d" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href="/fonts/BarlowSemiCondensed-600.woff2" as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Lumost" />
    <meta property="og:title" content={t.meta.title} />
    <meta property="og:description" content={t.meta.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={t.locale} />
    <meta name="twitter:card" content="summary" />
    <noscript><style>.rv{opacity:1;transform:none}</style></noscript>
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  </head>
  <body>
    <slot />
  </body>
</html>
