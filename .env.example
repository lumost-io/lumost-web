# Optional. Endpoint that accepts a JSON POST and returns 2xx, answering CORS preflight.
# Either a hosted form service, or the Resend relay in workers/contact/ (recommended).
# Leave empty and the contact form opens the visitor's mail app instead (mailto:).
PUBLIC_FORM_ENDPOINT=
# URL of the contact relay, e.g. https://contact.lumost.id — NOT https://lumost.id
